{
  "method": "Static checks of current source/config; not a live Helm install or ClickHouse execution",
  "chart_default_image_tag": "0.1.0",
  "release_publishes_git_ref_name": true,
  "release_also_publishes_latest": true,
  "example_git_tag": "v0.1.0",
  "example_release_image_tags": [
    "v0.1.0",
    "latest"
  ],
  "chart_tag_resolver_uses_app_version": false,
  "api_config_file_mounted": true,
  "api_config_file_env_set": false,
  "api_entrypoint_reads_only_explicit_config_path": true,
  "raw_cost_reconciles_span_and_metric_sources": true,
  "daily_view_selects_only_spans": true,
  "long_range_cost_reads_rollup_sum": true,
  "query_timeout_references": [
    "api/internal/config/config.go"
  ]
}
