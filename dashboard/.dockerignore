# Dependencies are installed inside the image via `npm ci`; never copy the
# host's node_modules (a pnpm symlink farm here) over it — the overlay can't
# replace the image's real directories with the host's symlinks.
node_modules

# Build output and local caches — regenerated by `npm run build` in the image.
dist
.vite
coverage

# VCS, env, and editor noise that has no place in the build context.
.git
.gitignore
.env
.env.*
*.log
.DS_Store
Dockerfile
.dockerignore
